OPENAI_API_KEY=sk-...

# Polar (https://polar.sh) — subscription checkout
# Organization Access Token, scoped to checkouts:write / products:read
POLAR_ACCESS_TOKEN=polar_oat_...
# Product ID of the SoundNative premium subscription, from the Polar dashboard
POLAR_PRODUCT_ID=...
# 'sandbox' (default, safe for local dev) or 'production'
POLAR_SERVER=sandbox
# Secret shown when creating the webhook endpoint in the Polar dashboard
POLAR_WEBHOOK_SECRET=whsec_...

# Resend (https://resend.com) — sends the "email my notes" feature
RESEND_API_KEY=re_...

# Supabase (server-side) — used to verify a caller's access token and to
# write subscription rows from the Polar webhook. NOT the anon key from
# .env — from Settings > API > Project API keys > service_role (secret).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
